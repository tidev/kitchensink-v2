<Alloy>
    <Window id="win" title="Image View (Zoom)">
        <!-- On iOS, pinch-zooming an image is implemented via a ScrollView container. -->
        <ScrollView
            id="scrollView"
            maxZoomScale="5"
            disableBounce="true"
            onSingletap="onSingleTap"
            onDoubletap="onDoubleTap"
            onScale="onScale"
            onScroll="onScroll"
            platform="ios">
            <ImageView id="imageView"/>
        </ScrollView>

        <!-- On Android, the ImageView itself supports a zoom feature. -->
        <ImageView id="imageView" enableZoomControls="true" platform="android"/>

        <View bottom="40" backgroundColor="white" borderRadius="25" width="200" height="50" onClick="close">
            <Label text="Close" color="black" />
        </View>
    </Window>
</Alloy>
